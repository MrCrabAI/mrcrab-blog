---
import { links } from '../data/links';
import LinkIcon from '../components/LinkIcon.astro';
import { withBase } from '../lib/url';
import '../styles/links.css';
const title = 'Mr. Crab — A small corner of the internet';
const description = 'Find Mr. Crab on YouTube and X. Videos, thoughts, and things I’m building.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff9ed" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/mr_crab_mark.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#links">Skip to links</a>
    <div class="page-decoration" aria-hidden="true"><span>✳</span><span>✳</span><span>✳</span><span>✳</span><span>✳</span><span>✳</span></div>
    <header class="topbar">
      <button class="share-button" id="share" type="button" aria-label="Share this page">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg>
      </button>
    </header>
    <main class="link-page">
      <section class="profile" id="about" aria-labelledby="profile-name">
        <div class="avatar-wrap">
          <div class="avatar">
            <div class="avatar-art">
              <img src={withBase('/assets/mr-crab-happy.png')} width="482" height="362" alt="Happy Mr. Crab with a big smile and golden sparkles" />
              <span class="avatar-star avatar-star--left" aria-hidden="true"></span>
              <span class="avatar-star avatar-star--right" aria-hidden="true"></span>
              <span class="avatar-star avatar-star--lower" aria-hidden="true"></span>
            </div>
          </div>


        </div>
        <h1 id="profile-name" aria-label="Hi, I’m Mr. Crab.">
          <span class="typewriter" data-typewriter aria-hidden="true">{Array.from('Hi, I’m Mr. Crab.').map((character, index) => (
            <span class:list={['type-char', { 'greeting-period': character === '.' && index === 16 }]}>{character}</span>
          ))}</span>
        </h1>
        <p class="bio">
          <span class="sr-only">Making AI easier to understand</span>
          <span class="typewriter" data-typewriter aria-hidden="true">{Array.from('Making AI easier to understand').map((character) => (
            <span class="type-char">{character}</span>
          ))}</span>
        </p>
      </section>
      <nav class="link-list" id="links" aria-label="Find Mr. Crab online">
        <div class="list-heading"><span>LET’S EXPLORE</span><span aria-hidden="true">↓</span></div>
        {links.map((link) => (
          <a class:list={['link-card', `link-card--${link.icon}`]} href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="link-icon"><LinkIcon name={link.icon} /></span>
            <span class="link-copy"><span class="link-title">{link.title}</span><span class="link-description">{link.description}</span></span>
            <span class="link-end"><span class="link-label">{link.label}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ))}
      </nav>
      <footer class="link-footer"><span class="footer-spark" aria-hidden="true">✳</span></footer>
    </main>
    <p id="share-status" class="share-status" role="status" aria-live="polite"></p>
    <dialog id="share-dialog"><form method="dialog"><h2>Share this little corner</h2><label for="share-url">Copy the link</label><input id="share-url" type="url" value={Astro.site?.href} readonly /><button type="submit">Done</button></form></dialog>
    <script>
      // Type each line in order. Full text remains visible without JavaScript.
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const lines = Array.from(document.querySelectorAll<HTMLElement>('[data-typewriter]'));
      if (!motion.matches) {
        const characters = lines.map(line => Array.from(line.querySelectorAll<HTMLElement>('.type-char')));
        lines.forEach(line => line.classList.add('is-typing'));
        characters.flat().forEach(character => character.dataset.visible = 'false');
        const startDelay = 150;
        const lineDuration = 1100;
        const lineGap = 180;
        const totalDuration = characters.length * lineDuration + Math.max(0, characters.length - 1) * lineGap;
        const start = performance.now() + startDelay;
        let frame = 0;
        const finish = () => {
          cancelAnimationFrame(frame);
          clearTimeout(fallback);
          lines.forEach(line => line.classList.remove('is-typing'));
          characters.flat().forEach(character => {
            character.dataset.visible = 'true';
            character.classList.remove('is-cursor');
          });
          motion.removeEventListener('change', finish);
        };
        const tick = (now: number) => {
          characters.forEach((row, lineIndex) => {
            const lineStart = start + lineIndex * (lineDuration + lineGap);
            const progress = Math.min(1, Math.max(0, (now - lineStart) / lineDuration));
            const count = Math.floor(progress * row.length);
            row.forEach((character, index) => {
              character.dataset.visible = String(index < count);
              character.classList.toggle('is-cursor', progress < 1 && count > 0 && index === count - 1);
            });
          });
          if (now >= start + totalDuration) finish();
          else frame = requestAnimationFrame(tick);
        };
        // Ensure both lines finish even when rendering frames are throttled.
        const fallback = setTimeout(finish, startDelay + totalDuration + 300);
        motion.addEventListener('change', finish);
        frame = requestAnimationFrame(tick);
      }

      const button = document.querySelector<HTMLButtonElement>('#share');
      const status = document.querySelector<HTMLElement>('#share-status');
      const dialog = document.querySelector<HTMLDialogElement>('#share-dialog');
      let statusTimer: ReturnType<typeof setTimeout>;
      button?.addEventListener('click', async () => {
        const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? window.location.href;
        try {
          if (navigator.share) await navigator.share({ title: 'Mr. Crab', url });
          else {
            await navigator.clipboard.writeText(url);
            if (status) {
              status.textContent = 'Link copied. See you around!';
              clearTimeout(statusTimer);
              statusTimer = setTimeout(() => { status.textContent = ''; }, 3500);
            }
          }
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          dialog?.showModal();
          document.querySelector<HTMLInputElement>('#share-url')?.select();
        }
      });
    </script>
    {import.meta.env.PROD && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "30b03ac6bd774242996f2ad0f1636aa7"}'></script>}
  </body>
</html>
